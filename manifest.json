{
  "manifest_version": 3,
  "name": "History Dashboard",
  "version": "0.1.0",
  "description": "Quickly view your browsing history and activity.",
  "permissions": ["history", "favicon"],
  "action": {
    "default_title": "Open History Dashboard"
  },
  "background": {
    "service_worker": "worker.js"
  }
}
